# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git 에 올라가지 않습니다)

# --- 에이전트 두뇌 (필수) ---
# 두뇌 선택: gemini (무료티어) / openai / anthropic — 앱 사이드바에서도 바로 전환 가능
LLM_PROVIDER=gemini

# Google Gemini (무료티어):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI:  https://platform.openai.com/api-keys
# gpt-5-nano 는 최저가지만 조사성 tool-calling(회사명 다단계 판단)에서 오류 확인(2026-08 실측)
# → GPT-5.6 Terra 로 교체. Sol(플래그십)보다 훨씬 저렴하면서 성능은 근접.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Anthropic Claude — API 키 불필요! 로그인된 Claude Code CLI 를 서브프로세스로 재활용한다
# (dart-agent/Martin's Bullseye 와 동일 방식). 이 PC에 `npm install -g @anthropic-ai/claude-code`
# 로 설치 후 `claude login` 으로 로그인만 되어 있으면 사이드바에서 'Anthropic Claude' 선택 시 바로 동작.
ANTHROPIC_MODEL=claude-sonnet-5

# --- 무료 등록 키 ---
# 한국 공시/재무:  https://opendart.fss.or.kr/  (인증키 신청)
DART_API_KEY=
# 한국은행 ECOS (국고채/매크로):  https://ecos.bok.or.kr/api/
ECOS_API_KEY=
# 미국 FRED (무위험이자율/매크로):  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# 일본 EDINET:  https://api.edinet-fsa.go.jp/  (API v2, 키 발급)
EDINET_API_KEY=
# 대만 FinMind:  https://finmindtrade.com/  (토큰)
FINMIND_TOKEN=
# 식별자 매핑(옵션):  https://www.openfigi.com/api
OPENFIGI_API_KEY=

# --- 키 불필요 (참고) ---
# SEC EDGAR 는 키 대신 연락처가 담긴 User-Agent 를 요구합니다.
SEC_USER_AGENT=sksq-agent your-email@sksquare.com

# ─────────────────────────────────────────────────────────────────
# 배포용 (로컬 개발엔 필요 없음 — 자세한 건 DEPLOY.md)
# ─────────────────────────────────────────────────────────────────
# 1 로 두면 배포 모드: claude CLI 두뇌를 숨기고, 인증 미설정 시 앱을 열지 않는다.
# DEPLOY_MODE=1

# 로그인 게이트 — 아래 중 하나는 반드시 설정해야 배포 앱이 열린다.
#  (a) 사용자별 비밀번호(권장) — 대화기록도 사람별로 격리된다
# APP_USERS=sanghwa:비번1,동료이름:비번2
#  (b) 공용 비밀번호 1개 — 제일 간단하지만 대화기록이 공유된다
# APP_PASSWORD=

# 관리자(/admin 페이지 접근) — 팀원의 사용현황·대화 원문을 볼 수 있다.
# 생략하면 APP_USERS 의 첫 번째 계정이 관리자가 된다. 공용 비밀번호 설정에는 관리자가 없다.
# ADMIN_USERS=sanghwa

# 로그인 쿠키 서명 키. 배포에선 반드시 지정(없으면 재시작마다 전원 로그아웃).
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
# 로그인 유지 기간(일). 기본 7.
# SESSION_TTL_DAYS=7

# 한 질문에 허용하는 LLM 왕복(라운드) 수. 기본 12.
# 한 라운드에서 도구를 여러 개 부를 수 있어 '도구 호출 횟수' 상한이 아니다.
# 무한루프·비용 폭주를 막는 안전장치다. 정식 평가 절차서를 쓰면 데이터 작업 전에 2~4 라운드를
# 쓰므로 6 이하로 내리면 DCF 한 건이 중간에 끊길 수 있다.
# AGENT_MAX_ROUNDS=12

# 영구 저장 경로. 호스팅에선 볼륨 마운트 경로를 넣는다(예: /data).
# 비워두면 앱 폴더에 쓰고, 재배포 때 대화기록·캐시가 사라진다.
# DATA_DIR=/data
