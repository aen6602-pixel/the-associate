# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (.env 는 git 에 올라가지 않습니다)

# --- 에이전트 두뇌 (필수) ---
# 두뇌 선택: gemini (무료티어) 또는 anthropic
LLM_PROVIDER=gemini

# Google Gemini (무료티어):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude:  https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- 무료 등록 키 ---
# 한국 공시/재무:  https://opendart.fss.or.kr/  (인증키 신청)
DART_API_KEY=
# 한국은행 ECOS (국고채/매크로):  https://ecos.bok.or.kr/api/
ECOS_API_KEY=
# 미국 FRED (무위험이자율/매크로):  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# 일본 EDINET:  https://api.edinet-fsa.go.jp/  (API v2, 키 발급)
EDINET_API_KEY=
# 대만 FinMind:  https://finmindtrade.com/  (토큰)
FINMIND_TOKEN=
# 식별자 매핑(옵션):  https://www.openfigi.com/api
OPENFIGI_API_KEY=

# --- 키 불필요 (참고) ---
# SEC EDGAR 는 키 대신 연락처가 담긴 User-Agent 를 요구합니다.
SEC_USER_AGENT=sksq-agent your-email@sksquare.com
